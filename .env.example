# Reference only: scripts/download_firms.py reads the key from the FIRMS_MAP_KEY environment
# variable, never from a file. Set it in your shell before running the script:
#   PowerShell:  $env:FIRMS_MAP_KEY = "your_map_key_here"
#   bash/zsh:    export FIRMS_MAP_KEY=your_map_key_here
# Get a MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_map_key_here
